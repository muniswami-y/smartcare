{
  "name": "caresmart",
  "version": "1.0.0",
  "private": true,
  "description": "CareSmart: Transparent, Paperless Hospital Management System for India",
  "workspaces": [
    "database",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "db:migrate": "npm run migrate:dev --workspace=database",
    "db:seed": "npm run seed:demo --workspace=database",
    "db:seed:prod": "npm run seed:production --workspace=database",
    "backend:dev": "npm run dev --workspace=backend",
    "frontend:dev": "npm run dev --workspace=frontend"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
