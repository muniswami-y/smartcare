PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:password@localhost:5432/caresmart?schema=public
REDIS_URL=redis://localhost:6379

# Cryptographic and Auth Secrets
JWT_ACCESS_SECRET=caresmart_super_secure_jwt_access_secret_2026_at_least_32_chars
JWT_REFRESH_SECRET=caresmart_super_secure_jwt_refresh_secret_2026_at_least_32_chars
FIELD_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
PHONE_HASH_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

CORS_ORIGIN=http://localhost:5173
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

UPLOAD_DIR=./uploads

# Payments (Razorpay test mode credentials)
RAZORPAY_KEY_ID=rzp_test_sampleKeyId12345
RAZORPAY_KEY_SECRET=rzp_test_sampleSecretKey67890
RAZORPAY_WEBHOOK_SECRET=sample_webhook_secret_12345
